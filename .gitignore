# Secrets and local configuration — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
npm-debug.log*

# Local coverage caches. Do not add *.out, coverage.*, build/ or dist/ here: they hid committed experiment
# output (tests/test_check_entry.py guards this). The secret and cache patterns above still apply inside
# experiments/*/output/ on purpose; if one hides a file that run.json lists, scripts/check_entry.py fails.
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
